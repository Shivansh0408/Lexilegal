# Backend server
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000
ANALYSIS_DATA_DIR=
LAWYER_CHUNK_CHARACTERS=3000
LAWYER_TIMEOUT_SECONDS=180
LAWYER_NUM_CTX=8192
LAWYER_NUM_PREDICT=1200
LAWYER_MAX_CONSECUTIVE_FAILURES=2
MAX_UPLOAD_MB=25

# Local Ollama judge model
LLAMA_API_URL=http://localhost:11434/api/generate
LLAMA_MODEL=llama3.2:3b
LLAMA_TIMEOUT_SECONDS=300
LLAMA_RETRIES=1
LLAMA_NUM_CTX=16384
LLAMA_NUM_PREDICT=4096
JUDGE_CHUNK_CHARACTERS=8000

# LangChain + Chroma saved-analysis RAG chatbot
OLLAMA_BASE_URL=http://localhost:11434
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_CHUNK_SIZE=1400
RAG_CHUNK_OVERLAP=180
RAG_RETRIEVAL_K=10
RAG_FETCH_K=30
RAG_NUM_CTX=8192
RAG_NUM_PREDICT=900
